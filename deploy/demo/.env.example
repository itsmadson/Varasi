# Copy to .env and fill in. Never commit the real .env.

# Postgres (pgSTAC). Keep POSTGRES_USER=postgres for pgstac compatibility.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=varasi

# MinIO (derived-thumbnail storage; internal only).
MINIO_ROOT_USER=varasi
MINIO_ROOT_PASSWORD=CHANGE_ME_strong_minio_password
MINIO_BUCKET=varasi-derived

# Auth secrets — MUST be long & random in production.
JWT_SECRET=CHANGE_ME_64_char_random_hex
INTERNAL_TOKEN=CHANGE_ME_random_token

# Public origin nginx serves the app on (used for CORS). e.g. https://varasi.geotajak.ir
WEB_ORIGIN=https://varasi.geotajak.ir

# Host ports the shared nginx proxies to (change if occupied on the demo host).
WEB_PORT=9292        # nginx  location /        -> this
CONTROL_PORT=8282    # nginx  /api /catalog /ws -> this
